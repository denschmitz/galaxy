{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Galaxy: UI Human Test (Normal Launch)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "streamlit",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "args": [
        "run",
        "${workspaceFolder}/src/galaxy/ui.py",
        "--server.fileWatcherType",
        "none",
        "--browser.gatherUsageStats",
        "false"
      ]
    },
    {
      "name": "Galaxy: UI Human Test (Isolated User Library)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "streamlit",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "args": [
        "run",
        "${workspaceFolder}/src/galaxy/ui.py",
        "--server.fileWatcherType",
        "none",
        "--browser.gatherUsageStats",
        "false",
        "--",
        "--scene-dir",
        "${workspaceFolder}/artifacts/human-test-scenes"
      ]
    },
    {
      "name": "Galaxy: UI Open Selected Scene",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "streamlit",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src",
        "GALAXY_UI_INPUT_PATH": "${input:sceneCard}"
      },
      "args": [
        "run",
        "${workspaceFolder}/src/galaxy/ui.py",
        "--server.fileWatcherType",
        "none",
        "--browser.gatherUsageStats",
        "false"
      ]
    },
    {
      "name": "Galaxy: Validate Pillars Example",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "galaxy.cli",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "args": [
        "validate-scene",
        "--scene",
        "${workspaceFolder}/artifacts/Pillars.json"
      ]
    },
    {
      "name": "Galaxy: Validate Selected Scene",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "galaxy.cli",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "args": ["validate-scene", "--scene", "${input:sceneCard}"]
    },
    {
      "name": "Galaxy: Run User Scene",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "galaxy.cli",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "args": ["run", "--scene", "${input:userSceneCard}"]
    },
    {
      "name": "Galaxy: Reproduce User Scene",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "galaxy.cli",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "args": ["reproduce", "--scene", "${input:userSceneCard}"]
    },
    {
      "name": "Galaxy: Human-Flow Automated Checks",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "args": [
        "-q",
        "tests/test_ui.py::test_streamlit_normal_launch_opens_pillars_example_and_inventory",
        "tests/test_ui.py::test_example_save_creates_new_identity_without_modifying_source",
        "tests/test_ui.py::test_pillars_inventory_is_remote_only_and_ignores_unreferenced_files"
      ]
    },
    {
      "name": "Galaxy: Complete Offline Test Suite",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": { "PYTHONPATH": "${workspaceFolder}/src" },
      "args": ["-q"]
    }
  ],
  "inputs": [
    {
      "id": "sceneCard",
      "type": "promptString",
      "description": "Scene-card JSON path",
      "default": "artifacts/Pillars.json"
    },
    {
      "id": "userSceneCard",
      "type": "promptString",
      "description": "User-owned scene-card JSON path (do not select a bundled example)",
      "default": "artifacts/scenes/scene.scene.json"
    }
  ]
}
