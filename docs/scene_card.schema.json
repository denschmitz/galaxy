          "type": "string"
        },
        "data_uri": {
          "pattern": ".*\\S.*",
          "title": "Data Uri",
          "type": "string"
        },
        "observation_id": {
          "pattern": ".*\\S.*",
          "title": "Observation Id",
          "type": "string"
        },
        "mission": {
          "pattern": ".*\\S.*",
          "title": "Mission",
          "type": "string"
        },
        "instrument": {
          "pattern": ".*\\S.*",
          "title": "Instrument",
          "type": "string"
        },
        "detector": {
          "pattern": ".*\\S.*",
          "title": "Detector",
          "type": "string"
        },
        "filter": {
          "pattern": ".*\\S.*",
          "title": "Filter",
          "type": "string"
        },
        "product_type": {
          "pattern": ".*\\S.*",
          "title": "Product Type",
          "type": "string"
        },
        "product_version": {
          "pattern": ".*\\S.*",
          "title": "Product Version",
          "type": "string"
        },
        "filename": {
          "pattern": ".*\\S.*",
          "title": "Filename",
