        },
        "kernel_asset_id": {
          "pattern": ".*\\S.*",
          "title": "Kernel Asset Id",
          "type": "string"
        },
        "max_iterations": {
          "maximum": 100,
          "minimum": 1,
          "title": "Max Iterations",
          "type": "integer"
        },
        "regularization": {
          "minimum": 0,
          "title": "Regularization",
          "type": "number"
        }
      },
      "title": "PSFPlane",
      "type": "object"
    },
    "Percentiles": {
      "additionalProperties": false,
      "properties": {
        "black": {
          "maximum": 100,
          "minimum": 0,
          "title": "Black",
          "type": "number"
        },
        "white": {
          "maximum": 100,
          "minimum": 0,
          "title": "White",
          "type": "number"
        }
      },
      "title": "Percentiles",
      "type": "object"
    },
    "Planes": {
